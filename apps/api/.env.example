# AstroSDK Configuration Example
# Copy this file to .env and adjust the settings

# Required: Path to Swiss Ephemeris data files (.se1, etc.)
# If not set, it defaults to /usr/share/libswe/ephe (Linux default)
SE_EPHE_PATH=/Users/teja/Projects/astro-sdk/apps/api/app/resources/ephe

# Optional: Configuration for determinism levels (for future extensions)
# ASTROSDK_STRICT_DETERMINISM=true
# ASTROSDK_THREAD_POOL_SIZE=4
